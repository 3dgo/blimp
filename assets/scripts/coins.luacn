-- 金币：城堡和办公室里都能捡的东西。由构建转译为 coins.lua：改这个文件。
-- 每个有金币的关卡脚本都引入它：
--     令 金币模块 = 引入("assets/scripts/coins")
--
-- 关卡里的金币是名为 金币_1、金币_2…… 的实体（编号连续，找不到就是数完了）。模型随意（这里是涂成金色的轮子），
-- 只设 Renderable（会动，探针烘焙要忽略它），碰撞设 None（玩家穿过去捡）。
--
-- 模块不保存状态（CLAUDE.md：Lua 从不保存状态）：捡到的总数和每枚捡没捡过都存在 游戏 表里，切换关卡后还在；
-- 捡过的金币隐藏起来。回到一关时它是从文件重新载入的，金币都在，所以 开始 按 游戏 表把捡过的再藏好。

令 金币模块 = {}

令 上       = 矢量3(0, 1, 0)
令 总数键   = "金币"   -- 游戏 表里的键：一共捡了几枚
令 拾取距离 = 0.25     -- 玩家身体中点到金币多近算捡到（scale 为 1 时）
令 半身高   = 0.2      -- 玩家身体中点的高度（scale 为 1 时，player 模块的 身高 的一半）
令 转速     = 3        -- 每秒的弧度
令 文字颜色 = 矢量4(1, 0.85, 0.3, 1)

-- 每枚金币在 游戏 表里一个键。带上关卡名，两个关卡的 金币_1 才不会混在一起。
令 函数 已捡键(关卡, i)
    返回 "已捡 " .. 关卡 .. " " .. i
结束

-- 在 世界.开始 里调用。关卡：这一关的名字（"城堡"、"办公室"），每关不同。
函数 金币模块.开始(关卡)
    令 i = 1
    当 真 做
        令 币 = 世界.查找("金币_" .. i)
        如果 非 实体.有效(币) 那么 中断 结束
        如果 游戏.取数(已捡键(关卡, i)) == 1 那么 实体.隐藏(币) 结束
        i = i + 1
    结束
结束

-- 在 世界.更新 里每次调用：金币转起来，玩家碰到就捡起。
函数 金币模块.更新(关卡, 玩家, t)
    如果 非 实体.有效(玩家) 那么 返回 结束
    令 大小 = 实体.取缩放(玩家).x
    令 中点 = 实体.取位置(玩家) + 上 * (半身高 * 大小)
    令 i = 1
    当 真 做
        令 币 = 世界.查找("金币_" .. i)
        如果 非 实体.有效(币) 那么 中断 结束
        如果 非 实体.是否隐藏(币) 那么
            实体.设朝向(币, 四元数.轴角(上, t * 转速 + i))   -- 各枚错开一点
            如果 (实体.取位置(币) - 中点):长度() < 拾取距离 * 大小 那么
                实体.隐藏(币)
                游戏.设数(已捡键(关卡, i), 1)
                游戏.设数(总数键, 游戏.取数(总数键) + 1)
                世界.播放声音("assets/sounds/ping.wav", 0.6)
            结束
        结束
        i = i + 1
    结束
结束

-- 在 世界.界面 里调用：屏幕左上角画出一共捡了几枚。
函数 金币模块.界面()
    界面.位置(0.03, 0.04)
    界面.文字("金币  " .. 游戏.取数(总数键), 文字颜色, 2)
结束

返回 金币模块
