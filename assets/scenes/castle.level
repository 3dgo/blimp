[world]
background = 0.07, 0.08, 0.11
exposure = 0
shading = Lambert
script = assets/scripts/castle.lua
light_groups.group_1.name = torches
light_groups.group_1.scale = 1
light_groups.group_1.pattern = mmnmmommommnonmmonqnmmo
light_groups.group_2.name = beacon
light_groups.group_2.scale = 1
light_groups.group_2.pattern = 
light_groups.group_3.name = windows
light_groups.group_3.scale = 1
light_groups.group_3.pattern = 
light_groups.group_4.name = 
light_groups.group_4.scale = 1
light_groups.group_4.pattern = 
bake.quality = High
bake.rays = 1024
bake.bounces = 4
bake.sky = true
bake.sky_color = 0.35, 0.45, 0.75
bake.sky_intensity = 0.8
bake.probe_spacing = 0.75
bake.bounds = Auto
bake.bounds_min = 0, 0, 0
bake.bounds_max = 0, 0, 0
retro.ps1.on = true
retro.ps1.low_res = true
retro.ps1.lines = 216
retro.ps1.vertex_snap = true
retro.ps1.snap = 1
retro.ps1.affine = true
retro.ps1.warp = 1
retro.ps1.point_sampling = true
retro.ps1.quantize = true
retro.ps1.color_bits = 5
retro.ps1.dither = 1
retro.crt.on = true
retro.crt.composite = true
retro.crt.luma_blur = 0.25
retro.crt.chroma_blur = 0.8
retro.crt.scanlines = true
retro.crt.scanline_strength = 0.5
retro.crt.beam_dark = 0.32
retro.crt.beam_bright = 0.6
retro.crt.mask = true
retro.crt.mask_strength = 0.1
retro.crt.bloom = true
retro.crt.bloom_strength = 0.06
retro.crt.bloom_radius = 3
retro.crt.gamma = 2.3
retro.crt.brightness = 1

